&lt;p&gt;Congratulations to Gayatri for successfully defending her PhD thesis, &amp;ldquo;Orchestrating User-centric Privacy via Web Browsers&amp;rdquo;, and officially earning the title of Dr. Gayatri!&lt;/p&gt;
&lt;p&gt;Some photos from her defense:&lt;/p&gt;
&lt;section class="photo-gallery" aria-label="Photo gallery"&gt;
&lt;img src="https://iitgn-fuss.github.io/misc/gallery/gayatri-defense1_hu_f6f78337ad4281eb.jpg" alt="Gayatri’s PhD Defense 1" srcset="https://iitgn-fuss.github.io/misc/gallery/gayatri-defense1_hu_f6f78337ad4281eb.jpg 800w, https://iitgn-fuss.github.io/misc/gallery/gayatri-defense1_hu_387f2d0767c9847.jpg 1600w" sizes="(max-width: 800px) 100vw, 800px" width="800" height="602" loading="lazy" /&gt;
&lt;img src="https://iitgn-fuss.github.io/misc/gallery/gayatri-defense2_hu_7028788610954816.jpg" alt="Gayatri’s PhD Defense 2" srcset="https://iitgn-fuss.github.io/misc/gallery/gayatri-defense2_hu_7028788610954816.jpg 800w, https://iitgn-fuss.github.io/misc/gallery/gayatri-defense2_hu_c322db0a8a430872.jpg 1600w" sizes="(max-width: 800px) 100vw, 800px" width="800" height="1063" loading="lazy" /&gt;
&lt;/section&gt;
&lt;script&gt;
(() =&gt; {
const gallery = document.currentScript.previousElementSibling;
const images = gallery ? Array.from(gallery.querySelectorAll(":scope &gt; img")) : [];
if (!gallery || images.length === 0) return;
let layoutFrame;
const layoutGallery = () =&gt; {
layoutFrame = undefined;
if (images.some((image) =&gt; image.naturalWidth === 0 || image.naturalHeight === 0)) return;
const styles = window.getComputedStyle(gallery);
const rowHeight = Number.parseFloat(styles.getPropertyValue("--photo-gallery-row")) || 8;
const rowGap = Number.parseFloat(styles.rowGap) || 16;
images.forEach((image) =&gt; {
if (image.clientWidth === 0) return;
const imageHeight = image.clientWidth * (image.naturalHeight / image.naturalWidth);
const rowSpan = Math.max(1, Math.ceil((imageHeight + rowGap) / (rowHeight + rowGap)));
image.style.setProperty("--photo-gallery-span", rowSpan);
});
gallery.classList.add("is-masonry");
};
const scheduleLayout = () =&gt; {
if (layoutFrame) return;
layoutFrame = window.requestAnimationFrame(layoutGallery);
};
images.forEach((image) =&gt; {
if (image.complete) scheduleLayout();
else image.addEventListener("load", scheduleLayout, { once: true });
});
if ("ResizeObserver" in window) {
new ResizeObserver(scheduleLayout).observe(gallery);
} else {
window.addEventListener("resize", scheduleLayout, { passive: true });
}
})();
&lt;/script&gt;
