      <description>
        
        
        &lt;p&gt;Here&amp;rsquo;s some photos from our group lunch at Triton, Ahmedabad; partly to celebrate the &amp;ldquo;Dr. Gayatri&amp;rdquo; and partly towards Prof. Abhishek&amp;rsquo;s promotion to Associate Professor few months back.
&lt;section class=&#34;photo-gallery&#34; aria-label=&#34;Photo gallery&#34;&gt;
  &lt;img src=&#34;https://iitgn-fuss.github.io/misc/gallery/group_lunch_aug_26_1_hu_5b41c7d61230ab95.jpg&#34; alt=&#34;Group Lunch 1&#34;  srcset=&#34;https://iitgn-fuss.github.io/misc/gallery/group_lunch_aug_26_1_hu_5b41c7d61230ab95.jpg 800w, https://iitgn-fuss.github.io/misc/gallery/group_lunch_aug_26_1.jpg 1280w&#34; sizes=&#34;(max-width: 800px) 100vw, 800px&#34; width=&#34;800&#34; height=&#34;600&#34; loading=&#34;lazy&#34; /&gt;
&lt;img src=&#34;https://iitgn-fuss.github.io/misc/gallery/group_lunch_aug_26_2_hu_5968ce786fa8f90f.jpg&#34; alt=&#34;Group Lunch 2&#34;  srcset=&#34;https://iitgn-fuss.github.io/misc/gallery/group_lunch_aug_26_2_hu_5968ce786fa8f90f.jpg 800w, https://iitgn-fuss.github.io/misc/gallery/group_lunch_aug_26_2_hu_ffd63ae2e35ac5b4.jpg 1600w&#34; sizes=&#34;(max-width: 800px) 100vw, 800px&#34; width=&#34;800&#34; height=&#34;600&#34; loading=&#34;lazy&#34; /&gt;
&lt;img src=&#34;https://iitgn-fuss.github.io/misc/gallery/group_lunch_aug_26_3_hu_d02b6e08982944c2.jpg&#34; alt=&#34;Group Lunch 3&#34;  srcset=&#34;https://iitgn-fuss.github.io/misc/gallery/group_lunch_aug_26_3_hu_d02b6e08982944c2.jpg 800w, https://iitgn-fuss.github.io/misc/gallery/group_lunch_aug_26_3.jpg 960w&#34; sizes=&#34;(max-width: 800px) 100vw, 800px&#34; width=&#34;800&#34; height=&#34;1067&#34; loading=&#34;lazy&#34; /&gt;
&lt;img src=&#34;https://iitgn-fuss.github.io/misc/gallery/group_lunch_aug_26_4_hu_cb9f2c742f85ef65.jpg&#34; alt=&#34;Group Lunch 4&#34;  srcset=&#34;https://iitgn-fuss.github.io/misc/gallery/group_lunch_aug_26_4_hu_cb9f2c742f85ef65.jpg 800w, https://iitgn-fuss.github.io/misc/gallery/group_lunch_aug_26_4.jpg 1280w&#34; sizes=&#34;(max-width: 800px) 100vw, 800px&#34; width=&#34;800&#34; height=&#34;600&#34; loading=&#34;lazy&#34; /&gt;
&lt;img src=&#34;https://iitgn-fuss.github.io/misc/gallery/group_lunch_aug_26_5_hu_e17bdd90444f196e.jpg&#34; alt=&#34;Group Lunch 5&#34;  srcset=&#34;https://iitgn-fuss.github.io/misc/gallery/group_lunch_aug_26_5_hu_e17bdd90444f196e.jpg 800w, https://iitgn-fuss.github.io/misc/gallery/group_lunch_aug_26_5.jpg 1280w&#34; sizes=&#34;(max-width: 800px) 100vw, 800px&#34; width=&#34;800&#34; height=&#34;600&#34; loading=&#34;lazy&#34; /&gt;
&lt;/section&gt;

&lt;script&gt;
  (() =&gt; {
    const gallery = document.currentScript.previousElementSibling;
    const images = gallery ? Array.from(gallery.querySelectorAll(&#34;:scope &gt; img&#34;)) : [];

    if (!gallery || images.length === 0) return;

    let layoutFrame;
    const layoutGallery = () =&gt; {
      layoutFrame = undefined;
      if (images.some((image) =&gt; image.naturalWidth === 0 || image.naturalHeight === 0)) return;

      const styles = window.getComputedStyle(gallery);
      const rowHeight = Number.parseFloat(styles.getPropertyValue(&#34;--photo-gallery-row&#34;)) || 8;
      const rowGap = Number.parseFloat(styles.rowGap) || 16;

      images.forEach((image) =&gt; {
        if (image.clientWidth === 0) return;
        const imageHeight = image.clientWidth * (image.naturalHeight / image.naturalWidth);
        const rowSpan = Math.max(1, Math.ceil((imageHeight + rowGap) / (rowHeight + rowGap)));
        image.style.setProperty(&#34;--photo-gallery-span&#34;, rowSpan);
      });

      gallery.classList.add(&#34;is-masonry&#34;);
    };

    const scheduleLayout = () =&gt; {
      if (layoutFrame) return;
      layoutFrame = window.requestAnimationFrame(layoutGallery);
    };

    images.forEach((image) =&gt; {
      if (image.complete) scheduleLayout();
      else image.addEventListener(&#34;load&#34;, scheduleLayout, { once: true });
    });

    if (&#34;ResizeObserver&#34; in window) {
      new ResizeObserver(scheduleLayout).observe(gallery);
    } else {
      window.addEventListener(&#34;resize&#34;, scheduleLayout, { passive: true });
    }
  })();
&lt;/script&gt;
&lt;/p&gt;

      </description>
    </item>
    
