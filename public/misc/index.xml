  &lt;img src=&#34;https://iitgn-fuss.github.io/misc/gallery/buildsec_24_1.jpg&#34; alt=&#34;BuildSec 2024 Conference 1&#34;  loading=&#34;lazy&#34; /&gt;
&lt;img src=&#34;https://iitgn-fuss.github.io/misc/gallery/buildsec_24_2.jpg&#34; alt=&#34;BuildSec 2024 Conference 2&#34;  loading=&#34;lazy&#34; /&gt;
&lt;img src=&#34;https://iitgn-fuss.github.io/misc/gallery/buildsec_24_3.jpg&#34; alt=&#34;BuildSec 2024 Conference 3&#34;  loading=&#34;lazy&#34; /&gt;
&lt;/section&gt;

&lt;script&gt;
  (() =&gt; {
    const gallery = document.currentScript.previousElementSibling;
    const images = gallery ? Array.from(gallery.querySelectorAll(&#34;:scope &gt; img&#34;)) : [];

    if (!gallery || images.length === 0) return;

    let layoutFrame;
    const layoutGallery = () =&gt; {
      layoutFrame = undefined;
      if (images.some((image) =&gt; image.naturalWidth === 0 || image.naturalHeight === 0)) return;

      const styles = window.getComputedStyle(gallery);
      const rowHeight = Number.parseFloat(styles.getPropertyValue(&#34;--photo-gallery-row&#34;)) || 8;
      const rowGap = Number.parseFloat(styles.rowGap) || 16;

      images.forEach((image) =&gt; {
        if (image.clientWidth === 0) return;
        const imageHeight = image.clientWidth * (image.naturalHeight / image.naturalWidth);
        const rowSpan = Math.max(1, Math.ceil((imageHeight + rowGap) / (rowHeight + rowGap)));
        image.style.setProperty(&#34;--photo-gallery-span&#34;, rowSpan);
      });

      gallery.classList.add(&#34;is-masonry&#34;);
    };

    const scheduleLayout = () =&gt; {
      if (layoutFrame) return;
      layoutFrame = window.requestAnimationFrame(layoutGallery);
    };

    images.forEach((image) =&gt; {
      if (image.complete) scheduleLayout();
      else image.addEventListener(&#34;load&#34;, scheduleLayout, { once: true });
    });

    if (&#34;ResizeObserver&#34; in window) {
      new ResizeObserver(scheduleLayout).observe(gallery);
    } else {
      window.addEventListener(&#34;resize&#34;, scheduleLayout, { passive: true });
    }
  })();
&lt;/script&gt;


