    <item>
      <title>Attended AsiaCCS 2026 in Bengaluru, India</title>
      <link>http://localhost:61763/people/subhrajit/updates/asia-ccs/</link>
      <pubDate>Sat, 06 Jun 2026 00:00:00 +0000</pubDate>
      
